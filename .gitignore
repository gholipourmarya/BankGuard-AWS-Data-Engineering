cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Environment variables and credentials
.env
.env.*
!.env.example
.aws/
*.pem
*.key

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated data
data/
output/

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
EOF